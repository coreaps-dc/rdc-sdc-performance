{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rdc-sdc-performance",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {
    "vars": {
      "RDC_DEPLOYMENT_MODE": "preview"
    }
  }
}
